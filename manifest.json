{
  "manifest_version": 3,
  "name": "GradeFlow",
  "version": "2.0.1",
  "description": "Improve SmartSchool with grade overviews, weighted averages, a theme editor, LAN chat, and arcade games.",
  "permissions": ["storage", "tabs", "offscreen", "alarms", "notifications", "scripting"],
  "host_permissions": ["https://*.smartschool.be/*"],
  "optional_host_permissions": ["https://*.smart-school.net/*"],
  "action": {
    "default_popup": "HTML/popup.html",
    "default_icon": { "128": "Assets/icon.png" }
  },
  "background": {
    "service_worker": "JS/background.js"
  },
  "commands": {
    "toggle-gf-chat": {
      "description": "Toggle the GradeFlow chat overlay"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://smartschool.be/*", "*://*.smartschool.be/*"],
      "js": ["JS/keybinds.js", "JS/themes.js", "JS/theme-engine.js", "JS/translations.js", "JS/content.js", "JS/update-modal.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://smartschool.be/*", "*://*.smartschool.be/*"],
      "js": ["JS/keybinds.js", "JS/chat/chat.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Assets/icon.png",
        "Assets/previews/*",
        "HTML/grades.html",
        "JS/grades.js",
        "CSS/grades.css",
        "CSS/smartschool-theme.css",
        "CSS/chat.css"
      ],
      "matches": ["*://smartschool.be/*", "*://*.smartschool.be/*"]
    }
  ]
}
